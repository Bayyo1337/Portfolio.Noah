@using Portfolio.Marvin.Components.Common
@using Portfolio.Marvin.Models.Configuration
@using Portfolio.Marvin.Providers.Interfaces
@using Microsoft.Extensions.Options

@inject IOptions<PortfolioConfiguration> Configuration
@inject ISkillProvider SkillProvider

<div class="personal">
   <div class="me-wrapper">
      <div class="me-image" style="background-image: url('@Config.GeneralInfo.ImageUrl')"></div>
   </div>
   <h3 class="name">@Config.GeneralInfo.Name</h3>
   <h4 class="job">@Config.GeneralInfo.JobTitle</h4>

   @if (!string.IsNullOrEmpty(Config.GeneralInfo.CurrentEmployer))
   {
       <div class="current-employment">
          Currently at
          @if (!string.IsNullOrEmpty(Config.GeneralInfo.CurrentEmployerLogoUrl))
          {
            <div class="employer-logo" style="background-image: url('@Config.GeneralInfo.CurrentEmployerLogoUrl')"></div>
          }
          else
          {
             <span>@Config.GeneralInfo.CurrentEmployer</span>
          }
       </div>
   }

   <div class="links">
      <PersonalLink SvgName="marker">
         <span style="font-size: 19px">@Config.GeneralInfo.Location</span>
      </PersonalLink>

      @foreach (var link in Config.SocialLinks)
      {
          <PersonalLink SvgName="@link.IconName">
             <a href="@link.Url" class="simple-link" target="_blank" style="font-size: 19px">@link.DisplayText</a>
          </PersonalLink>
      }
   </div>

   <div class="technologies">Skills I love and currently use</div>
   <TechnologyList SkillIds="@_skills"/>
   
   <div class="cv">This websites also generates my CV, open it with the link below</div>
   <NavLink class="cv-link" href="/cv" target="_blank">Open CV</NavLink>

   <div class="public-souce">This page is built with Blazor and is public source</div>
   <PersonalLink SvgName="github">
      <a href="https://github.com/MarvinDrude/Portfolio.Marvin" class="simple-link" target="_blank" style="font-size: 19px">Portfolio.Marvin</a>
   </PersonalLink>
</div>

@code {
   private PortfolioConfiguration Config => Configuration.Value;
   private List<string> _skills = [];

   protected override void OnInitialized()
   {
       // Pick some highlighted skills or all
       _skills = Config.Skills.Take(7).Select(s => s.Id).ToList();
   }
}
