[Unit]
Description=Portfolio Noah Richter - ASP.NET Core App
After=network.target

[Service]
WorkingDirectory=/opt/portfolio
ExecStart=/opt/portfolio/Portfolio.Noah
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=portfolio-noahrichter
User=portfolio
Group=portfolio
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:8080
# Environment=PORTFOLIO_HA_TOKEN=your_token_here

[Install]
WantedBy=multi-user.target
