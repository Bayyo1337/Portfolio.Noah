@using Portfolio.Noah.Components.Common
@using Portfolio.Noah.Models.Experiences

<div class="experience">
   <div class="header">
      <div class="date-range">
         <span class="date">@GetDateString(Experience.StartedAt)</span>
         <span class="separator">-</span>
         <span class="date">@GetDateString(Experience.EndedAt)</span>
      </div>
      <div class="title">@Experience.JobTitle</div>
      <div class="company">@Experience.CompanyName</div>
   </div>
   <div class="description-list">
      <ul>
         @foreach (var note in Experience.Descriptions)
         {
            <li>@note</li>
         }
      </ul>
   </div>
   <TechnologyList SkillIds="@Experience.SkillIds"/>
</div>

@code {
   [Parameter, EditorRequired]
   public required Experience Experience { get; set; }

   private string GetDateString(DateTimeOffset? date)
   {
       if (!date.HasValue || date == DateTimeOffset.MaxValue)
       {
           return "PRESENT";
       }
       return $"{date.Value.Month:D2}-{date.Value.Year}";
   }
}
