@using Portfolio.Noah.Models.Experiences

<div class="experience">
   <h3>@Experience.JobTitle</h3>
   <div class="detail">
      <div class="company">
         @Experience.CompanyName
      </div>
      <div class="spacer"></div>
      <div class="date">
         @GetDatesString()
      </div>
   </div>
   <div class="summary">
      <ul class="desc">
         @foreach (var note in Experience.Descriptions)
         {
            <li>@note</li>
         }
      </ul>
   </div>
</div>

@code {
   
   [Parameter, EditorRequired]
   public required Experience Experience { get; set; }
   
   private string GetDatesString()
   {
      return $"{GetDateString(Experience.StartedAt)} — {GetDateString(Experience.EndedAt)}";
   }
   
   private string GetDateString(DateTimeOffset? date)
   {
       if (!date.HasValue || date == DateTimeOffset.MaxValue)
       {
           return "PRESENT";
       }
       return $"{date.Value.Month:D2}-{date.Value.Year}";
   }
   
   private string GetDateString(DateTimeOffset date)
   {
      return $"{date.Month:D2}-{date.Year}";
   }
}
